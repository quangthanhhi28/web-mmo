# =====================================================
# CẤU HÌNH BACKEND - BÁN TÀI NGUYÊN PREMIUM
# =====================================================

# SERVER
PORT=5000
NODE_ENV=development

# DATABASE MYSQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scr_ban_tai_nguyen

# JWT SECRET - ĐỔI NGAY KHI TRIỂN KHAI THỰC TẾ
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=7d

# NGÂN HÀNG VIETNAM
VIETCOMBANK_ACCOUNT=1234567890
VIETCOMBANK_OWNER=NGUYEN VAN A
VIETCOMBANK_BRANCH=Hà Nội

MBBANK_ACCOUNT=9876543210
MBBANK_OWNER=TRAN VAN B
MBBANK_BRANCH=TP. Hồ Chí Minh

TECHCOMBANK_ACCOUNT=5555555555
TECHCOMBANK_OWNER=PHAM VAN C
TECHCOMBANK_BRANCH=Đà Nẵng

BIDV_ACCOUNT=3333333333
BIDV_OWNER=HOANG VAN D
BIDV_BRANCH=Cần Thơ

# API URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:5000/api

# LOG SETTINGS
LOG_LEVEL=debug

# SECURITY
SESSION_SECRET=session_secret_key_change_this

